# ARACHNE 3D Reconstruction Service Configuration

# Host & Port for Flask API service
HOST=127.0.0.1
PORT=5000

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins, or '*' for development
ARACHNE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Inference Device ('cuda', 'cpu', or leave empty for auto-detection)
# ARACHNE_DEVICE=cuda

# Hugging Face Model Cache Directory (optional)
# HF_HOME=C:\Users\<username>\.cache\huggingface

